<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="lab_world">
    <!-- Sun and Ground -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Room Walls (6m x 6m x 1m) -->
    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6.2 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6.2 0.2 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 6.0 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 6.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.2 6.0 1.0</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.2 6.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.7 1</ambient><diffuse>0.6 0.6 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 1: Box (Meja Lab) -->
    <model name="lab_table">
      <static>true</static>
      <pose>1.5 1.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 1.2 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 1.2 0.8</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: Cylinder (Pilar Lab) -->
    <model name="lab_pillar">
      <static>true</static>
      <pose>-1.2 -1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.3</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: Target Box (Objek Deteksi) -->
    <model name="target_box">
      <static>true</static>
      <pose>1.5 -1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
