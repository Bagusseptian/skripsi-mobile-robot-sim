<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="world_c_classroom">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ================= DINDING RUANG KELAS/LAB (12m x 10m x 1.5m) ================= -->
    <model name="class_north">
      <static>true</static>
      <pose>0 5.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>12.2 0.2 1.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>12.2 0.2 1.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.9 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="class_south">
      <static>true</static>
      <pose>0 -5.0 0.75 0 0 0</pose>
      <link name="link">
