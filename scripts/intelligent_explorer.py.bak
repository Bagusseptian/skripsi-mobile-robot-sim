    "tempat_a":       {"x": 1.5,  "y": -0.5, "desc": "Posisi Pengamatan Tenggara (Tempat A)"},
    "tempat_b":       {"x": -1.5, "y": 1.5,  "desc": "Posisi Pengamatan Barat Laut (Tempat B)"},
