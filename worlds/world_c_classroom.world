          <material><ambient>0.85 0.85 0.9 1</ambient><diffuse>0.85 0.85 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="class_west">
      <static>true</static>
      <pose>-6.0 0 0.75 0 0 0</pose>
      <link name="link">
